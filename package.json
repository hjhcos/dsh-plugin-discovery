{
  "name": "dsh-plugin-discovery",
  "version": "1.2.1",
  "type": "module",
  "description": "Discover and install community DSH bundles from the sidebar: newbie essentials, recommendations, categories, self-update, and npm/GitHub search.",
  "author": "hjhcos",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "bundle",
    "discovery",
    "marketplace",
    "recommend"
  ],
  "homepage": "https://github.com/hjhcos/dsh-plugin-discovery#readme",
  "bugs": {
    "url": "https://github.com/hjhcos/dsh-plugin-discovery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjhcos/dsh-plugin-discovery.git"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "mark-remote.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "data",
    "locale",
    "skill",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
